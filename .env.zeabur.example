# Required
NODE_ENV=production
BOT_TOKEN=
ADMIN_USER_IDS=

# Startup diagnostics and public health/version metadata
ENABLE_STARTUP_DIAGNOSTICS=true
SHOW_VERSION_INFO=true
HEALTH_CHECK_ENABLED=true
TELEGRAM_STARTUP_MAX_RETRIES=6
TELEGRAM_STARTUP_RETRY_BASE_MS=1000
TELEGRAM_STARTUP_RETRY_MAX_MS=30000

# Customer support. Use a separate BotFather token; never reuse BOT_TOKEN.
SUPPORT_ENABLED=true
SUPPORT_BOT_TOKEN=
SUPPORT_BOT_USERNAME=
SUPPORT_CONTACT_URL=
SUPPORT_ADMIN_IDS=
SUPPORT_SUPER_ADMIN_IDS=
SUPPORT_RATE_LIMIT_WINDOW_MS=60000
SUPPORT_RATE_LIMIT_MAX_MESSAGES=6
SUPPORT_TICKET_AUTO_CLOSE_MINUTES=1440

# Telegram Mini App
MINI_APP_ENABLED=true
MINI_APP_AUTH_MAX_AGE_SECONDS=3600

# Default AI behavior
DEFAULT_AI_PROVIDER=auto
DEFAULT_AI_MODEL=gemini-2.5-flash
ENABLE_USER_PROVIDER_SELECTION=true
ENABLE_USER_MODEL_SELECTION=true

# Automatic fallback
ENABLE_PROVIDER_FALLBACK=true
# Cross-provider fallback requires a separate API key for every provider used here.
AI_PROVIDER_FALLBACK_ORDER=gemini,groq,openrouter
# Extra retries after the first failed request (1 means at most 2 attempts per model).
AI_PROVIDER_MAX_RETRIES=1
AI_PROVIDER_RETRY_DELAY_MS=800
AI_PROVIDER_COOLDOWN_MS=60000
MODEL_LIST_CACHE_TTL_MS=3600000
MODEL_DISCOVERY_ENABLED=true

# Google Gemini free-tier first
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODELS=gemini-2.5-flash-lite

# OpenRouter free models
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openrouter/free
OPENROUTER_FALLBACK_MODELS=poolside/laguna-xs-2.1:free,cohere/north-mini-code:free
OPENROUTER_HTTP_REFERER=
OPENROUTER_APP_TITLE=Telegram AI Bot Pro

# Groq optional fast fallback
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.1-8b-instant
GROQ_FALLBACK_MODELS=openai/gpt-oss-20b,llama-3.3-70b-versatile

# Zeabur AI Hub / another OpenAI-compatible gateway (optional)
# To make this the fixed default, set DEFAULT_AI_PROVIDER=openai-compatible above.
# Paste the exact Base URL and model IDs shown by your gateway; no Hub URL is built in.
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=
AI_FALLBACK_MODELS=

# Other optional providers. Leave blank unless the account and model are verified.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=
OPENAI_FALLBACK_MODELS=
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_API_VERSION=2023-06-01
ANTHROPIC_MODEL=
ANTHROPIC_FALLBACK_MODELS=
GITHUB_MODELS_API_KEY=
GITHUB_MODELS_BASE_URL=https://models.github.ai/inference
GITHUB_MODELS_MODEL=
GITHUB_MODELS_FALLBACK_MODELS=
HUGGINGFACE_API_KEY=
HUGGINGFACE_BASE_URL=https://router.huggingface.co/v1
HUGGINGFACE_MODEL=
HUGGINGFACE_FALLBACK_MODELS=
MISTRAL_API_KEY=
MISTRAL_BASE_URL=https://api.mistral.ai/v1
MISTRAL_MODEL=
MISTRAL_FALLBACK_MODELS=
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_API_VERSION=
DEEPSEEK_MODEL=
DEEPSEEK_FALLBACK_MODELS=
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_API_VERSION=
QWEN_MODEL=
QWEN_FALLBACK_MODELS=
GROK_API_KEY=
GROK_BASE_URL=https://api.x.ai/v1
GROK_API_VERSION=
GROK_MODEL=
GROK_FALLBACK_MODELS=
GLM_API_KEY=
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
GLM_API_VERSION=
GLM_MODEL=
GLM_FALLBACK_MODELS=
DOUBAO_API_KEY=
DOUBAO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
DOUBAO_API_VERSION=
DOUBAO_MODEL=
DOUBAO_FALLBACK_MODELS=

# Dedicated capability providers
TRANSLATION_PROVIDER=gemini
TRANSLATION_MODEL=gemini-2.5-flash-lite
ROUTER_PROVIDER=gemini
ROUTER_MODEL=gemini-2.5-flash-lite
MEMORY_PROVIDER=gemini
MEMORY_MODEL=gemini-2.5-flash-lite
VISION_PROVIDER=gemini
VISION_MODEL=gemini-2.5-flash
TRANSCRIPTION_PROVIDER=gemini-live
TRANSCRIPTION_MODEL=
TTS_PROVIDER=gemini-live
TTS_MODEL=
IMAGE_PROVIDER=openai-compatible
IMAGE_MODEL=
IMAGE_SIZE=1024x1024
TTS_VOICE=alloy

# Gemini Live optional
GEMINI_LIVE_API_KEY=
GEMINI_LIVE_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_LIVE_MODEL=
GEMINI_LIVE_TRANSCRIPTION_MODEL=
GEMINI_LIVE_TTS_MODEL=
# Keep disabled unless GEMINI_LIVE_API_KEY and compatible Live models are configured.
ENABLE_LIVE_AUDIO=false
ENABLE_LIVE_TRANSLATE=false

# Smart AI Router (task-to-model selection)
# With DEFAULT_AI_PROVIDER=auto, configure each MODEL together with its PROVIDER.
# With a fixed default provider, a blank route provider uses that fixed provider.
# Model values are intentionally blank: copy IDs from your provider or AI Hub.
SMART_ROUTING_ENABLED=true
SMART_ROUTING_DEBUG=false
SMART_ROUTING_MIN_CONFIDENCE=0.55
ROUTER_GENERAL_PROVIDER=
ROUTER_GENERAL_MODEL=
ROUTER_TRANSLATION_PROVIDER=
ROUTER_TRANSLATION_MODEL=
ROUTER_CODE_PROVIDER=
ROUTER_CODE_MODEL=
ROUTER_REASONING_PROVIDER=
ROUTER_REASONING_MODEL=
ROUTER_LONG_CONTEXT_PROVIDER=
ROUTER_LONG_CONTEXT_MODEL=
ROUTER_DOCUMENT_PROVIDER=
ROUTER_DOCUMENT_MODEL=
ROUTER_VISION_PROVIDER=
ROUTER_VISION_MODEL=
ROUTER_OCR_PROVIDER=
ROUTER_OCR_MODEL=
ROUTER_TOOL_PROVIDER=
ROUTER_TOOL_MODEL=
ROUTER_CHEAP_PROVIDER=
ROUTER_CHEAP_MODEL=

# Features
# ENABLE_AI_ROUTER is the separate legacy LLM intent router.
ENABLE_AI_ROUTER=false
AI_ROUTER_MODE=single-pass
ENABLE_MEMORY_SUMMARY=true
MEMORY_SUMMARY_INTERVAL=5
AI_SYSTEM_PROMPT=You are a powerful Telegram AI assistant. Answer helpfully and concisely.
AI_TEMPERATURE=0.6
AI_MAX_TOOL_STEPS=3
ENABLE_TOOL_CALLS=true
ENABLE_WEB_SEARCH=true
ENABLE_GEMINI_GOOGLE_SEARCH=true
ENABLE_URL_FETCH=true
ENABLE_STREAMING_REPLIES=true
ENABLE_NATIVE_DRAFT_STREAMING=false
ENABLE_RICH_MESSAGES=true
RICH_MESSAGE_MIN_CHARS=600
STREAMING_EDIT_INTERVAL_MS=350
STREAMING_MIN_LENGTH=160
# Global fallback only; users can override these in the Mini App Console.
NEWS_REGION=MY
NEWS_LANGUAGE=auto
NEWS_TIME_ZONE=Asia/Kuala_Lumpur
# Recommended for stable web search; the keyless fallback is best-effort only.
TAVILY_API_KEY=
BRAVE_SEARCH_API_KEY=
TOOL_ALLOWED_NAMES=get_time,get_weather,fetch_url,web_search
TOOL_ALLOWED_USER_IDS=
TOOL_ALLOWED_CHAT_IDS=
TOOL_BLOCKED_USER_IDS=
TOOL_ADMIN_ONLY_NAMES=
TOOL_MAX_CALLS_PER_MESSAGE=4
TOOL_MAX_CONCURRENT_CALLS=8
TOOL_USER_WINDOW_MS=60000
TOOL_USER_MAX_CALLS=20
NETWORK_TOOL_SCOPE=all
NETWORK_TOOL_ALLOWED_USER_IDS=
NETWORK_TOOL_ALLOWED_CHAT_IDS=
ENABLE_SECRETARY_AUTO_REPLY=true
# Guard initial mode: queue=review, approve=open, decline=strict; admins can switch it in the bot
GUARD_DEFAULT_ACTION=queue
BOT_COLLABORATION_COOLDOWN_MS=5000
INLINE_QUERY_DEBOUNCE_MS=1200
# Shorter inline input only shows typing guidance; it does not call search/AI or spend credits.
INLINE_QUERY_MIN_CHARS=2
INLINE_QUERY_RESPONSE_TIMEOUT_MS=8000
INLINE_QUERY_SEARCH_TIMEOUT_MS=2300
INLINE_QUERY_AI_ATTEMPT_TIMEOUT_MS=2200
INLINE_QUERY_CACHE_TTL_MS=60000

# Limits
MAX_HISTORY_MESSAGES=32
MAX_CONTEXT_CHARS=48000
MAX_INPUT_CHARS=12000
MAX_OUTPUT_CHARS=3500
TELEGRAM_FILE_MAX_BYTES=10485760
TELEGRAM_FILE_DOWNLOAD_TIMEOUT_MS=20000
DOCUMENT_MAX_BYTES=6291456
DOCUMENT_MAX_CHARS=12000
DOCUMENT_CHUNK_CHARS=1800
CONVERSATION_RETENTION_DAYS=30
PRIVACY_SWEEP_INTERVAL_HOURS=24
MINI_APP_SHOW_USER_MESSAGES=false
PRIVACY_SESSION_TTL_MINUTES=30
PRIVACY_CONTEXT_MESSAGES=6
PRIVACY_CONTEXT_CHARS=12000
PRIVACY_SESSION_MAX_MESSAGES=50
REQUEST_TIMEOUT_MS=120000
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=12
# Legacy chat-only alias. Keep it aligned with STARS_FREE_CHAT_DAILY.
DAILY_QUOTA=20

# Telegram Stars digital-service billing. Keep JSON on one line in Zeabur.
# Prices are defined only here; the application does not provide paid defaults.
STARS_PAYMENTS_ENABLED=true
STARS_PRODUCTS_JSON=[{"id":"starter","title":"入门额度包","titleEn":"Starter credits","description":"包含约2次高成本AI Hub请求及免费平台扩展额度","descriptionEn":"Includes about 2 high-cost AI Hub requests plus free-provider credits","price":300,"credits":{"chat":30,"vision":20,"image_generation":5,"tts":20,"live_voice":10,"video":0}},{"id":"standard","title":"标准额度包","titleEn":"Standard credits","description":"包含约6次高成本AI Hub请求及日常功能额度","descriptionEn":"Includes about 6 high-cost AI Hub requests plus regular feature credits","price":800,"credits":{"chat":90,"vision":80,"image_generation":20,"tts":80,"live_voice":40,"video":0}},{"id":"pro","title":"高级额度包","titleEn":"Pro credits","description":"包含约16次高成本AI Hub请求及高频功能额度","descriptionEn":"Includes about 16 high-cost AI Hub requests plus high-volume feature credits","price":2000,"credits":{"chat":240,"vision":300,"image_generation":75,"tts":300,"live_voice":150,"video":0}}]
STARS_FREE_CHAT_DAILY=20
STARS_FREE_VISION_DAILY=3
STARS_FREE_IMAGE_DAILY=1
STARS_FREE_TTS_DAILY=2
STARS_FREE_LIVE_VOICE_DAILY=2
STARS_FREE_VIDEO_DAILY=0
STARS_ORDER_TTL_MINUTES=60
STARS_USAGE_RESERVATION_TTL_MINUTES=15
STARS_REFUND_LEASE_SECONDS=300
STARS_TERMS_TEXT=
STARS_SUPPORT_TEXT=
BILLING_USD_PER_CHAT_CREDIT=0.10
BILLING_USD_PER_VISION_CREDIT=
BILLING_USD_PER_IMAGE_CREDIT=
BILLING_USD_PER_TTS_CREDIT=
BILLING_USD_PER_LIVE_VOICE_CREDIT=
BILLING_USD_PER_VIDEO_CREDIT=
BILLING_COST_MARKUP=1.50
BILLING_MAX_REQUEST_USD=2
AI_MAX_OUTPUT_TOKENS=2048
FREE_MODEL_PATTERNS=:free,gemini-2.5-flash-lite
PAID_MODEL_PATTERNS=claude-opus,claude-sonnet,gpt-5
FREE_PROVIDER_PATTERNS=gemini,gemini-live,groq,openrouter,github-models,huggingface,mistral,openai,anthropic,deepseek,qwen,grok,glm,doubao
PAID_PROVIDER_PATTERNS=openai-compatible
AGENT_ENABLED=false
AGENT_MAX_TASK_USD=5
AGENT_MAX_RUNTIME_MINUTES=60
AGENT_WORKER_URL=
AGENT_WORKER_SECRET=
PUBLIC_BASE_URL=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_SLUG=
GITHUB_APP_CALLBACK_PATH=/auth/github/callback
GITHUB_TOKEN_ENCRYPTION_KEY=
ENABLE_VIDEO=false

# Storage / Zeabur
DATABASE_FILE=/data/bot-data.db
DATA_FILE=/data/bot-data.json
# Keep an existing CHAT_ENCRYPTION_KEY unchanged. Generate LOG_PRIVACY_KEY
# separately with `openssl rand -base64 48`; the two values must differ.
CHAT_ENCRYPTION_REQUIRED=true
CHAT_ENCRYPTION_KEY=
LOG_PRIVACY_KEY=
PORT=8080
HEALTH_PORT=8080
HEALTHCHECK_TIMEOUT_MS=3000

# Admin API
ADMIN_API_ENABLED=false
ADMIN_API_PORT=3001
ADMIN_API_PREFIX=/admin/api/v1
ADMIN_API_TOKEN=
ALLOWED_USER_IDS=
ALLOWED_CHAT_IDS=
BLOCKED_USER_IDS=

# Group behavior
GROUP_TRIGGER_MODE=smart
GROUP_TRIGGER_KEYWORD=ai

# Legacy compatibility. New deployments should use DEFAULT_AI_PROVIDER above.
AI_PROVIDER=
